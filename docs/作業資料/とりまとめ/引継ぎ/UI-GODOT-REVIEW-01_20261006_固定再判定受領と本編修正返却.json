  "decisions": [
    {
      "id": "DEC-UI-01",
      "status": "登録済み定義を特定／未登録用途は人の個別判断待ち",
      "unresolved": "原本bundleにScrollText/Check/Grid2X2/Clock3/Plus/CircleCheck/Inbox/Undo2/Store/LayoutGrid/Mountainの実定義がない。本編候補の由来だけで採用済みにはできない。",
      "human_decision": "未登録の各用途をA/Bまたは既存別原本の正確な参照で指定。まとめて全UIを承認し直さない。"
    },
    {
      "id": "DEC-UI-02",
      "status": "回答確定（公開値の読取専用対応）",
      "unresolved": null,
      "human_decision": "不要。既了承の公開属性表示の復元。"
    },
    {
      "id": "DEC-UI-03",
      "status": "原本挙動と基準の差を整理／人の個別判断待ち",
      "unresolved": "原本実コードと「窓外離脱」説明の境界が一致しない。位置確認だけで本編の追加挙動を採用済みにしない。",
      "human_decision": "root内空白の保持/160ms閉鎖と、preview入口追加の可否を個別指定。"
    },
    {
      "id": "DEC-UI-04",
      "status": "比較条件確定／修正前のAA許容採用は未決",
      "unresolved": "既知のmetric差を修正した原寸対がまだないため、AAだけを残した具体比較が未成立。過去OS/AA未取得は成功と扱わず、今回の可能な判定を止めない。",
      "human_decision": "現在はAI/本編のmetrics修正待ち。修正後の名指したAA比較が成立した時にだけA/Bの残差採用を案内。"
    },
    {
      "id": "DEC-UI-05",
      "status": "共通部品対応を返却／追加routeの配置は人の個別判断待ち",
      "unresolved": "追加routeのA/B配置は原本の一対一再現だけで一意に決まらない。上記比較と既存原寸/コードを判断資料とし、新しい合意案を無断採用しない。",
      "human_decision": "各routeのA/Bと必要な限定条件を個別指定。原本footer再現など判断不要の修正は待たず本編へ。 ownedの合法ST-P08は未取得のため、そのrouteはAI側の比較補完待ち。既存契約担当の入力と本編の原寸が届くまで人の開始条件を満たした扱いにしない。"
    },
    {
      "id": "DEC-UI-06",
      "status": "回答確定（既存scroll保持条件を維持）",
      "unresolved": null,
      "human_decision": "不要。新しい操作仕様を作らず、既存の保持条件を適用。"
    }
  ],
