    "text_history": [
      {
        "id": "SCN-001-TXT01",
        "scene_ids": [
          "SCN-001-S01"
        ],
        "published": true,
        "read": false,
        "kind": "main",
        "short_text": "「雨は降っていないんです。それなのに夜になると、地下から潮の匂いがして。品物は上へ移しましたが、いつまでも使わないわけにはいかなくて」",
        "detail_text": null
      },
      {
        "id": "SCN-001-TXT02",
        "scene_ids": [
          "SCN-001-S01"
        ],
        "published": true,
        "read": false,
        "kind": "main",
        "short_text": "流れに逆らい、障害を越えて奥へ進む探索。途中の相手を調べる余地もある。",
        "detail_text": null
      },
      {
        "id": "SCN-001-TXT03",
        "scene_ids": [
          "SCN-001-S02"
        ],
        "published": true,
        "read": true,
        "kind": "main",
        "short_text": "水が、下り坂を上ってくる。壁の白い筋を辿ると、照明の途切れた奥へ続いていた。",
        "detail_text": null
      },
      {
        "id": "SCN-001-TXT04",
        "scene_ids": [
          "SCN-001-S02"
        ],
        "published": true,
        "read": true,
        "kind": "main",
        "short_text": "古い潜水服が流れの中に立っている。足元の水だけが割れ、こちらへ重い腕を伸ばした。",
        "detail_text": null
      },
      {
        "id": "SCN-001-COND01",
        "scene_ids": [
          "SCN-001-S02"
        ],
        "published": true,
        "read": false,
        "kind": "conditional",
        "short_text": "逆らう水の働きが、掌ほどの櫂に収まる。今なら、この流れを使えそうだ。",
        "detail_text": null
      },
      {
        "id": "SCN-001-COND02",
        "scene_ids": [
          "SCN-001-S02"
        ],
        "published": true,
        "read": false,
        "kind": "conditional",
        "short_text": "靴底を重ねると、足元が沈むように落ち着く。あの潜水服が立っていた理由の一端が分かった。",
        "detail_text": null
      },
      {
        "id": "SCN-001-TXT05",
        "scene_ids": [
          "SCN-001-S03"
        ],
        "published": true,
        "read": false,
        "kind": "main",
        "short_text": "通路を抜けると、頭上に海があった。遠い舟底の影が、港の屋根をゆっくり横切っていく。",
        "detail_text": null
      },
      {
        "id": "SCN-001-TXT06",
        "scene_ids": [
          "SCN-001-S03"
        ],
        "published": true,
        "read": false,
        "kind": "main",
        "short_text": "港の壁にも、地下で見た水位の筋がある。奥の水門で噴き返した白い水が、こちらの通路へ流れ込んでいた。",
        "detail_text": null
      },
      {
        "id": "SCN-001-COND04",
        "scene_ids": [
          "SCN-001-S03"
        ],
        "published": true,
        "read": false,
        "kind": "conditional",
        "short_text": "通路の角を越える。振り返ると、潜水服はまだ、同じ流れの中に立っていた。",
        "detail_text": null
      },
      {
        "id": "SCN-001-TXT07",
        "scene_ids": [
          "SCN-001-S04"
        ],
        "published": true,
        "read": false,
        "kind": "main",
        "short_text": "鎖が歯車に噛み込み、逃がし口を開いたまま留めている。擦れた正常位置は、そのすぐ隣にあった。",
        "detail_text": null
      },
      {
        "id": "SCN-001-DETAIL06",
        "scene_ids": [
          "SCN-001-S04"
        ],
        "published": true,
        "read": true,
        "kind": "detail",
        "short_text": "水門の裏に古い案内板がある。港の名の隣に「渡り場」の文字。使われなくなっても、道筋は残っているらしい。",
        "detail_text": "水門の裏に古い案内板がある。港の名の隣に「渡り場」の文字。使われなくなっても、道筋は残っているらしい。"
      },
      {
        "id": "SCN-001-COND06",
        "scene_ids": [
          "SCN-001-S06"
        ],
        "published": true,
        "read": false,
        "kind": "conditional",
        "short_text": "「奥の水門が戻らなくなっています。原因は分かりましたが、まだ直せていません」",
        "detail_text": null
      }
    ]
  }
}
