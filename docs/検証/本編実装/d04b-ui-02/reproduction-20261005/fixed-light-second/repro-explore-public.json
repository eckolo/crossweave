      {
        "short_text": "\u6C34\u304C\u3001\u4E0B\u308A\u5742\u3092\u4E0A\u3063\u3066\u304F\u308B\u3002\u58C1\u306E\u767D\u3044\u7B4B\u3092\u8FBF\u308B\u3068\u3001\u7167\u660E\u306E\u9014\u5207\u308C\u305F\u5965\u3078\u7D9A\u3044\u3066\u3044\u305F\u3002",
