      },
      {
        "short_text": "\u53E4\u3044\u6F5C\u6C34\u670D\u304C\u6D41\u308C\u306E\u4E2D\u306B\u7ACB\u3063\u3066\u3044\u308B\u3002\u8DB3\u5143\u306E\u6C34\u3060\u3051\u304C\u5272\u308C\u3001\u3053\u3061\u3089\u3078\u91CD\u3044\u8155\u3092\u4F38\u3070\u3057\u305F\u3002",
