    "texts": {
      "SCN-001-TXT03": {
        "id": "SCN-001-TXT03",
        "title": null,
        "short_text": "水が、下り坂を上ってくる。壁の白い筋を辿ると、照明の途切れた奥へ続いていた。",
        "detail_text": null,
        "kind": "main",
        "read": true
      },
      "SCN-001-TXT04": {
        "id": "SCN-001-TXT04",
        "title": null,
        "short_text": "古い潜水服が流れの中に立っている。足元の水だけが割れ、こちらへ重い腕を伸ばした。",
        "detail_text": null,
        "kind": "main",
        "read": true
      },
      "SCN-001-DETAIL01": {
        "id": "SCN-001-DETAIL01",
        "title": null,
        "short_text": "塩を含んだ水は、乾いても白く残る。床には何度も拭いた跡があり、低い棚だけが空になっている。",
        "detail_text": "塩を含んだ水は、乾いても白く残る。床には何度も拭いた跡があり、低い棚だけが空になっている。",
        "kind": "detail",
        "read": true
      },
      "SCN-001-DETAIL02": {
        "id": "SCN-001-DETAIL02",
        "title": null,
        "short_text": "窓の内側は暗く、中に何があるのかは分からない。潮が引いても、重い靴だけは床から離れない。",
        "detail_text": "窓の内側は暗く、中に何があるのかは分からない。潮が引いても、重い靴だけは床から離れない。",
        "kind": "detail",
        "read": true
      },
      "SCN-001-OBJ-ENTRY": {
        "id": "SCN-001-OBJ-ENTRY",
        "title": null,
        "short_text": "地下へ流れ込む水の出所を調べる",
        "detail_text": null,
        "kind": "objective",
        "read": false
      }
    },
